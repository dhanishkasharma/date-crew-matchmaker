{
  "name": "tdc-matchmaker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && tsup server/index.ts --format esm --platform node --target node22 --out-dir dist/server --clean",
    "build:client": "npm run typecheck && vite build",
    "build:server": "npm run typecheck && tsup server/index.ts --format esm --platform node --target node22 --out-dir dist/server --clean",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "tsx server/seed-command.ts",
    "demo:refresh-text": "tsx server/refresh-demo-command.ts",
    "evaluate:ai": "tsx scripts/evaluate-ai.ts",
    "check:services": "node scripts/check-services.mjs",
    "check:gemini": "node scripts/check-gemini.mjs",
    "lint": "eslint client server shared tests --max-warnings 0",
    "setup": "node scripts/setup-env.mjs",
    "format": "prettier --write client server shared tests docs scripts *.md *.json *.ts *.mjs index.html",
    "format:check": "prettier --check client server shared tests docs scripts *.md *.json *.ts *.mjs index.html"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.59.0",
    "mongoose": "^9.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "mongodb-memory-server-core": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
