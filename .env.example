# Copy this file to .env. Secrets belong on the server only.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
# Leave empty to use the development-only, disk-persisted local MongoDB.
# Its binary downloads once on first launch. Atlas is required for hosted use.
MONGODB_URI=
SESSION_SECRET=replace-with-a-long-random-value-before-deployment
GEMINI_API_KEY=
# Pick a text model with free-tier quota in your AI Studio project.
GEMINI_MODEL=gemini-3.5-flash-lite
